# Python build and cache artifacts. These were previously committed to
# the repository (see the history before this file existed): the bytecode
# is version-specific, the egg-info is regenerated by every build, and
# neither belongs in version control.
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checkers and linters
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Editor and OS noise
.idea/
.vscode/
.DS_Store

# Generated analysis inputs and derived run output. The committed
# reports/ are small curated summary artefacts; these are the raw,
# regenerable per-run directories produced by scripts/.
data/prepared/
